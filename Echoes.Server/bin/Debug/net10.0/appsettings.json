{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017/echoes",
    "DatabaseName": "echoes"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG",
    "Issuer": "EchoesServer",
    "Audience": "EchoesClient"
  },
  "Cloudinary": {
    "CloudName": "your-cloud-name",
    "ApiKey": "your-api-key",
    "ApiSecret": "your-api-secret"
  }
}
